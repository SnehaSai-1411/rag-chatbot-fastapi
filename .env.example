# LLM provider: "claude" or "openai"
LLM_PROVIDER=claude

# Only the key for the provider above is needed. Without a key, /ask falls
# back to an extractive answer (a labeled excerpt from the retrieved chunks).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Chroma persistence directory and collection name
CHROMA_DIR=./chroma_db
COLLECTION=my-docs

# Default number of chunks retrieved per question
TOP_K=5

# Conversation turns kept per session in SQLite
HISTORY_TURNS=10
